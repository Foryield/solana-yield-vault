{
  "name": "@foryield/solana-yield-vault-client",
  "version": "0.1.0",
  "private": true,
  "description": "Composition des instructions et derivation des adresses des deux programmes",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
