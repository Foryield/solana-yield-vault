# Copier vers .env.local. TOUT EST EXIGE, RIEN N'EST DEDUIT.
#
# Meme regle que la ligne de commande d'administration : deviner le reseau ou
# un identifiant de programme est precisement ce qu'on veut eviter. Une valeur
# manquante arrete la page avec un message, elle ne la degrade pas en silence.
#
# Les valeurs ci-dessous sont celles de devnet, publiques et verifiables.
#
# Le point d'acces public suffit en local et pour l'integration continue. Il ne
# suffit PAS a une page publique : il plafonne a 100 requetes par tranche de 10
# secondes et par IP, et la documentation Solana dit qu'il n'est pas destine
# aux applications. Le site deploye vise un point d'acces dedie, dont l'URL
# porte une cle et se saisit au tableau de bord de l'hebergeur, jamais ici.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_VAULT_PROGRAM_ID=2bkjZG8njXHQ1tdj5aRSiwjjndX1qEvjFYzBYJQjNysw
NEXT_PUBLIC_HOOK_PROGRAM_ID=EGbJBdCUK5ecUiVJ9FFiGdVEZQ15cE31zNm97RUpFK63
NEXT_PUBLIC_DEPOSIT_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Prereglages de l'ecran de transfert : deux porteurs de demonstration, l'un
# sur la liste d'autorisation, l'autre non. Cles publiques seules.
NEXT_PUBLIC_PORTEUR_AUTORISE=Dz7mzmQS9YDvDMu9faWms41rfcyUM3vZDRXu9ZNhLgKr
NEXT_PUBLIC_PORTEUR_NON_AUTORISE=BeBQQqjuUFU1qjJayMg46CWuaKw7oTJ5R4UfoVLVKohL
